{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/buscar-cotizacion/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cotizaciones/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/generar-pdf-auto/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/guardar-ganancia/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/productos-precio/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/subir-pdf/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/carrito/detalles/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/carrito/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/config/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/marketplace/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/Negociaciones/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/pedidos/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/solicitudes/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}