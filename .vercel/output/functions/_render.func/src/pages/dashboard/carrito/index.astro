---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:5145';

async function safeFetch(url: string) {
  try {
    const res = await fetch(url);
    const text = await res.text();
    if (!res.ok || !text || text.trim() === '') return { success: false, data: null };
    return JSON.parse(text);
  } catch (e) {
    return { success: false, data: null };
  }
}

// Fetch cotizaciones DownLabs
const cotizacionesData = await safeFetch(`${API_URL}/api/cotizaciones?pageSize=500`);
console.log('cotizaciones:', cotizacionesData);

// Las cotizaciones de DownLabs
const allCotizaciones: any[] = cotizacionesData.data ?? [];

// Enrich lista con cotizaciones
const enrichedCotizaciones = allCotizaciones.map((cot: any) => {
  const totalPrice = cot.precio_final_cliente || 0;
  const costoEnvio = cot.costo_envio || 0;
  return { 
    ...cot, 
    _id: cot.id_cotizaciondwnlabs || cot.id_cotizacion,
    _totalPrice: totalPrice,
    _costoEnvio: costoEnvio
  };
});

const grandTotal = enrichedCotizaciones.reduce((s: number, c: any) => s + (c._totalPrice || 0), 0);

function formatMoney(n: number) {
  return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2 });
}

function formatDate(d: string) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<DashboardLayout title="Carrito · Operadores">
  <div class="p-6 md:p-8 max-w-6xl mx-auto">

    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm text-outline mb-3">
        <a href="/dashboard" class="hover:text-primary transition-colors">Dashboard</a>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-primary font-medium">Cotizaciones DownLabs</span>
      </nav>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="font-headline text-3xl font-extrabold text-on-surface tracking-tight">Cotizaciones DownLabs</h1>
          <p class="text-on-surface-variant mt-1">{enrichedCotizaciones.length} cotización(es) · Total: {formatMoney(grandTotal)}</p>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <div class="bg-surface-container-lowest rounded-xl p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-secondary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-secondary">description</span>
        </div>
        <div>
          <p class="text-[10px] text-outline font-bold uppercase tracking-widest">Total Cotizaciones</p>
          <p class="font-headline text-2xl font-extrabold text-on-surface">{enrichedCotizaciones.length}</p>
        </div>
      </div>
      <div class="bg-surface-container-lowest rounded-xl p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary">payments</span>
        </div>
        <div>
          <p class="text-[10px] text-outline font-bold uppercase tracking-widest">Valor Total</p>
          <p class="font-headline text-2xl font-extrabold text-primary">{formatMoney(grandTotal)}</p>
        </div>
      </div>
    </div>

    {enrichedCotizaciones.length === 0 ? (
      <div class="bg-surface-container-lowest rounded-xl px-6 py-16 text-center">
        <span class="material-symbols-outlined text-6xl block mb-4 text-outline/15">receipt_long</span>
        <p class="text-lg font-semibold text-on-surface">No hay cotizaciones DownLabs</p>
        <p class="text-sm text-outline mt-1">Las cotizaciones generadas aparecerán aquí.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {enrichedCotizaciones.map((cot: any) => (
          <div 
            class="cotizacion-card cursor-pointer bg-surface-container-lowest rounded-xl p-5 border border-outline-variant/10 hover:border-primary/30 transition-all"
            data-cot={JSON.stringify(cot)}
          >
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <p class="font-bold text-on-surface">Cotización DownLabs</p>
                <p class="text-xs font-mono text-outline">ID: {String(cot._id || '').slice(0, 8)}</p>
                {cot.id_solicitud && <p class="text-xs text-outline">Solicitud: {String(cot.id_solicitud).slice(0, 8)}</p>}
              </div>
              <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-secondary/10 text-secondary">
                {cot.estado || 'Sin estado'}
              </span>
            </div>
            <div class="flex gap-6 text-sm">
              <span class="text-outline">Fecha: {formatDate(cot.created_at)}</span>
              <span>Costo envío: {formatMoney(cot._costoEnvio)}</span>
              <span class="text-primary font-bold">Total cliente: {formatMoney(cot._totalPrice)}</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Modal de Detalle -->
  <dialog id="modal-detalle" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title-group">
          <div class="modal-icon">
            <span class="material-symbols-outlined text-2xl">description</span>
          </div>
          <div>
            <h3 class="font-headline text-lg font-bold">Detalle de Cotización</h3>
          </div>
        </div>
        <button id="btn-cerrar-modal" class="modal-close">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="modal-body">
        <div id="modal-contenido" class="space-y-4">
          <!-- Se llena dinámicamente -->
        </div>
      </div>
    </div>
  </dialog>

  <style>
    .modal { background: transparent; border: none; padding: 0; max-width: 500px; width: 95vw; margin: auto; }
    .modal::backdrop { background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); }
    .modal[open] { animation: modalFadeIn 0.25s cubic-bezier(0.34,1.56,0.64,1); }
    @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.9) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    .modal-content { background: var(--color-surface-container-lowest,#fefefe); border-radius: 1.5rem; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; background: var(--color-primary,#6750a1); color: white; }
    .modal-title-group { display: flex; align-items: center; gap: 0.75rem; }
    .modal-icon { width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; }
    .modal-close { width: 2.5rem; height: 2.5rem; border-radius: 50%; border: none; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; color: white; cursor: pointer; }
    .modal-close:hover { background: rgba(255,255,255,0.25); }
    .modal-body { padding: 1.5rem; overflow-y: auto; max-height: 80vh; }
  </style>

  <script>
    const modal = document.getElementById('modal-detalle') as HTMLDialogElement;
    const btnCerrar = document.getElementById('btn-cerrar-modal');
    const modalContenido = document.getElementById('modal-contenido');

    document.querySelectorAll('.cotizacion-card').forEach(card => {
      card.addEventListener('click', () => {
        const cot = JSON.parse(card.getAttribute('data-cot') || '{}');
        
        if (!modalContenido || !cot) return;

        modalContenido.innerHTML = `
          <div class="bg-surface-container-low p-4 rounded-xl">
            <p class="text-xs text-outline uppercase tracking-widest mb-2">ID Cotización</p>
            <p class="font-mono text-sm text-on-surface">${cot.id_cotizaciondwnlabs || cot._id || '—'}</p>
          </div>

          <div class="bg-surface-container-low p-4 rounded-xl">
            <p class="text-xs text-outline uppercase tracking-widest mb-2">ID Solicitud</p>
            <p class="font-mono text-sm text-on-surface">${cot.id_solicitud || '—'}</p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="bg-surface-container-low p-4 rounded-xl">
              <p class="text-xs text-outline uppercase tracking-widest mb-1">Estado</p>
              <p class="font-bold text-secondary">${cot.estado || '—'}</p>
            </div>
            <div class="bg-surface-container-low p-4 rounded-xl">
              <p class="text-xs text-outline uppercase tracking-widest mb-1">Fecha creación</p>
              <p class="text-sm text-on-surface">${cot.created_at ? new Date(cot.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'}</p>
            </div>
          </div>

          <div class="bg-surface-container-low p-4 rounded-xl border-l-4 border-primary">
            <p class="text-xs text-outline uppercase tracking-widest mb-3">Desglose de Costos</p>
            <div class="space-y-2">
              <div class="flex justify-between">
                <span class="text-outline">Precio productos</span>
                <span class="font-bold text-on-surface">$${(cot.precio_productos || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-outline">Costo envío</span>
                <span class="font-bold text-on-surface">$${(cot.costo_envio || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-outline">Costos operación</span>
                <span class="font-bold text-on-surface">$${(cot.costos_operacion || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
              </div>
              <div class="flex justify-between pt-2 border-t border-outline-variant/20">
                <span class="font-bold text-primary">Total cliente</span>
                <span class="font-bold text-primary text-lg">$${(cot.precio_final_cliente || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
              </div>
            </div>
          </div>

          <div class="bg-surface-container-low p-4 rounded-xl">
            <p class="text-xs text-outline uppercase tracking-widest mb-1">Ganancia DownLabs</p>
            <p class="font-bold text-tertiary text-lg">$${(cot.ganancia_downlabs || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}</p>
          </div>

          <div class="bg-surface-container-low p-4 rounded-xl">
            <p class="text-xs text-outline uppercase tracking-widest mb-1">Última actualización</p>
            <p class="text-sm text-on-surface">${cot.updated_at ? new Date(cot.updated_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'}</p>
          </div>
        `;

        modal.showModal();
      });
    });

    btnCerrar?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  </script>
</DashboardLayout>