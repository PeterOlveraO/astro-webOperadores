---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:5145';

const operadorId =
  Astro.cookies.get('id_operador')?.value ??
  Astro.cookies.get('operador_id')?.value;

if (!operadorId || operadorId === 'undefined' || operadorId === 'null') {
  return Astro.redirect('/');
}

async function safeFetch(url: string) {
  try {
    const res = await fetch(url);
    const text = await res.text();
    if (!res.ok || !text || text.trim() === '') return { success: false, data: null };
    return JSON.parse(text);
  } catch (e) {
    return { success: false, data: null };
  }
}

const productosData = await safeFetch(`${API_URL}/api/catalogo-productos?pageSize=300`);

const allProducts = (productosData.data ?? []).map((p: any) => {
  const ratings = p.ratings_productos || [];
  const avg = ratings.length > 0
    ? ratings.reduce((s: number, r: any) => s + r.calificacion, 0) / ratings.length
    : 0;

  return { 
    ...p, 
    _avgRating: Math.round(avg * 10) / 10, 
    _totalReviews: ratings.length
  };
});

// Group by category
const categories: Record<string, any[]> = {};
for (const p of allProducts) {
  const cat = p.categoria || 'Otros';
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(p);
}
const categoryEntries = Object.entries(categories).sort((a, b) => b[1].length - a[1].length);

const catIcons: Record<string, string> = {
  'Periféricos': 'keyboard', 'Monitores': 'monitor', 'Audio': 'headphones',
  'Mobiliario': 'chair', 'Accesorios': 'cable', 'Computadoras': 'computer',
  'Redes': 'router', 'Almacenamiento': 'storage', 'Impresoras': 'print',
};
const catColors: Record<string, string> = {
  'Periféricos': 'from-blue-500/10 to-blue-600/5', 'Monitores': 'from-violet-500/10 to-violet-600/5',
  'Audio': 'from-rose-500/10 to-rose-600/5', 'Mobiliario': 'from-emerald-500/10 to-emerald-600/5',
  'Accesorios': 'from-amber-500/10 to-amber-600/5', 'Computadoras': 'from-cyan-500/10 to-cyan-600/5',
};

function renderStars(level: number): string {
  let html = '';
  for (let i = 0; i < 5; i++)
    html += i < Math.round(level)
      ? '<span class="text-amber-400 text-xs">★</span>'
      : '<span class="text-outline/30 text-xs">★</span>';
  return html;
}
---
<DashboardLayout title="Catálogo · Operadores">
  <div class="p-6 md:p-8 max-w-7xl mx-auto relative">

    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm text-outline mb-3">
        <a href="/dashboard" class="hover:text-primary transition-colors">Dashboard</a>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-primary font-medium">Catálogo de Productos</span>
      </nav>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="font-headline text-3xl font-extrabold text-on-surface tracking-tight">Catálogo de Proveedores</h1>
          <p class="text-on-surface-variant mt-1">Explora todos los productos disponibles. {allProducts.length} productos en {categoryEntries.length} categorías.</p>
        </div>
        <div class="relative flex-shrink-0 w-80">
          <!-- Modificamos el placeholder para quitar "proveedor" -->
          <input type="text" id="catalog-search" placeholder="Buscar por ID, nombre, material..." class="w-full bg-surface-container-lowest border-none py-3 px-4 pl-10 rounded-xl text-sm text-on-surface placeholder-outline focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm" />
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-lg">search</span>
        </div>
      </div>
    </div>

    <!-- Category quick nav -->
    <div class="flex gap-2 mb-8 overflow-x-auto pb-2 flex-wrap">
      {categoryEntries.map(([cat, items]) => (
        <a href={`#cat-${cat.toLowerCase().replace(/\s/g, '-')}`} class="flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container-low transition-colors text-sm font-medium text-on-surface-variant hover:text-on-surface whitespace-nowrap">
          <span class="material-symbols-outlined text-base text-primary">{catIcons[cat] || 'category'}</span>
          {cat}
          <span class="text-[10px] font-bold text-outline bg-outline/10 px-1.5 py-0.5 rounded-full">{items.length}</span>
        </a>
      ))}
    </div>

    <!-- Category sections -->
    <div class="space-y-10" id="catalog-sections">
      {categoryEntries.map(([cat, items]) => (
        <section id={`cat-${cat.toLowerCase().replace(/\s/g, '-')}`} class="catalog-section" data-category={cat.toLowerCase()}>
          <!-- Section header -->
          <div class={`rounded-2xl bg-gradient-to-r ${catColors[cat] || 'from-primary/10 to-primary/5'} p-6 mb-5`}>
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-white/80 flex items-center justify-center shadow-sm">
                <span class="material-symbols-outlined text-primary text-2xl">{catIcons[cat] || 'category'}</span>
              </div>
              <div>
                <h2 class="font-headline text-xl font-extrabold text-on-surface">{cat}</h2>
                <p class="text-sm text-on-surface-variant">{items.length} producto{items.length > 1 ? 's' : ''} disponible{items.length > 1 ? 's' : ''}</p>
              </div>
            </div>
          </div>

          <!-- Products grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {items.map((p: any) => {
              const imgUrl = p.imagen_url;
              const desc = p.descripcion || p.materiales || '';
              const avg = p._avgRating;
              const reviews = p._totalReviews;
              return (
                <div class="product-card-catalog bg-surface-container-lowest rounded-xl overflow-hidden hover:shadow-lg hover:shadow-primary/5 transition-all group cursor-pointer border border-outline-variant/10 hover:border-primary/20"
                  data-name={p.nombre_articulo?.toLowerCase()}
                  data-materials={p.materiales?.toLowerCase()}
                  data-desc={p.descripcion?.toLowerCase()}
                  data-uuid={p.id_producto?.toLowerCase()}
                >
                  <!-- Image -->
                  <div class="h-40 bg-surface-container-high overflow-hidden relative">
                    {imgUrl ? (
                      <img src={imgUrl} alt={p.nombre_articulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-5xl text-outline/15">{catIcons[cat] || 'category'}</span>
                      </div>
                    )}
                    {reviews > 0 && (
                      <div class="absolute top-2 right-2 flex items-center gap-1 bg-black/60 backdrop-blur-sm text-white px-2 py-1 rounded-lg text-[10px] font-bold">
                        <span class="text-amber-400">★</span> {avg} ({reviews})
                      </div>
                    )}
                  </div>

                  <!-- Info -->
                  <div class="p-4">
                    <h3 class="font-bold text-on-surface text-sm mb-1">{p.nombre_articulo}</h3>
                    <p class="text-[11px] text-on-surface-variant line-clamp-2 mb-3 leading-relaxed">{desc || 'Sin descripción'}</p>
                    <div class="flex items-center justify-between">
                      <div>
                        <!-- Se eliminó la línea del proveedor y estrellas aquí -->
                        <p class="text-[10px] text-outline">Material: {p.materiales?.split(',')[0] || 'No especificado'}</p>
                      </div>
                      <p class="font-headline text-xl font-extrabold text-primary">${p.precio_mayorista?.toFixed(2)}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <!-- Empty search state -->
    <div id="no-results" class="hidden text-center py-16 text-outline">
      <span class="material-symbols-outlined text-5xl block mb-3 opacity-20">search_off</span>
      <p class="text-lg font-semibold">Sin resultados</p>
      <p class="text-sm mt-1">Intenta con otro término de búsqueda o UUID.</p>
    </div>
  </div>

  <!-- ✨ MODAL DE DETALLE DE PRODUCTO ✨ -->
  <dialog id="modal-producto" class="bg-transparent m-auto p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm open:animate-in open:fade-in open:zoom-in-95">
    <div class="bg-surface-container-lowest w-full max-w-3xl rounded-2xl shadow-2xl overflow-hidden border border-outline-variant/20">
      
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-outline-variant/10 flex items-center justify-between bg-surface-container-low">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined" id="modal-icon">inventory_2</span>
          </div>
          <div>
            <h3 class="font-bold text-on-surface text-lg" id="modal-title">Detalle del Producto</h3>
            <p class="text-xs text-outline font-mono mt-0.5" id="modal-uuid">---</p>
          </div>
        </div>
        <button id="btn-close-modal" class="w-8 h-8 rounded-full flex items-center justify-center text-outline hover:bg-surface-container-highest hover:text-on-surface transition-colors">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>
      
      <!-- Modal Body -->
      <div class="p-6">
        <div class="flex flex-col md:flex-row gap-6">
          
          <!-- Imagen del producto (Izquierda) -->
          <div class="w-full md:w-5/12 h-64 bg-surface-container-high rounded-xl overflow-hidden flex items-center justify-center relative">
            <img id="modal-img" src="" alt="Producto" class="w-full h-full object-cover hidden" />
            <span id="modal-no-img" class="material-symbols-outlined text-6xl text-outline/20">image</span>
          </div>
          
          <!-- Datos principales (Derecha) -->
          <div class="w-full md:w-7/12 flex flex-col gap-4">
            
            <div class="bg-surface-container-low p-4 rounded-xl">
              <p class="text-[10px] font-bold uppercase tracking-wider text-outline mb-1">Precio Mayorista</p>
              <p class="text-3xl font-extrabold text-primary" id="modal-precio">$0.00</p>
            </div>

            <div class="bg-surface-container-low p-3 rounded-xl border border-outline-variant/10">
              <p class="text-[10px] font-bold uppercase tracking-wider text-outline flex items-center gap-1 mb-1">
                <span class="material-symbols-outlined text-[12px]">category</span> Categoría
              </p>
              <p class="text-sm font-bold text-on-surface truncate" id="modal-cat">---</p>
            </div>

            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-outline mb-1">Materiales / Composición</p>
              <p class="text-sm text-on-surface-variant bg-surface-container-low px-3 py-2 rounded-lg" id="modal-mat">---</p>
            </div>

          </div>
        </div>

        <div class="mt-6">
          <p class="text-[10px] font-bold uppercase tracking-wider text-outline mb-2">Descripción Detallada</p>
          <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
            <p class="text-sm text-on-surface-variant leading-relaxed whitespace-pre-line" id="modal-desc">---</p>
          </div>
        </div>
      </div>
      
      <!-- Modal Footer -->
      <div class="px-6 py-4 bg-surface-container-low border-t border-outline-variant/10 flex justify-end">
        <button id="btn-close-modal-footer" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-surface-container-highest text-on-surface hover:bg-outline/10 transition-colors">
          Cerrar
        </button>
      </div>
    </div>
  </dialog>

  <style>
    /* Animación fluida para cuando se abre el modal */
    dialog[open] {
      animation: zoom-in 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes zoom-in {
      0% { opacity: 0; transform: scale(0.95) translateY(10px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
  </style>

  <!-- Pasamos los datos del servidor a variables globales -->
  <script define:vars={{ allProducts, catIcons }}>
    window.__CATALOG_PRODUCTS__ = allProducts;
    window.__CATALOG_ICONS__ = catIcons;
  </script>

  <script>
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
    const sections = document.querySelectorAll('.catalog-section');
    const cards = document.querySelectorAll('.product-card-catalog');
    const noResults = document.getElementById('no-results')!;
    
    // Variables del Modal
    const modal = document.getElementById('modal-producto') as HTMLDialogElement;
    const prodData = (window as any).__CATALOG_PRODUCTS__ || [];
    const iconsData = (window as any).__CATALOG_ICONS__ || {};

    // 1. Lógica de Búsqueda (Sin buscar por proveedor)
    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      let anyVisible = false;

      if (!q) {
        cards.forEach(c => (c as HTMLElement).style.display = '');
        sections.forEach(s => (s as HTMLElement).style.display = '');
        noResults.classList.add('hidden');
        return;
      }

      sections.forEach(section => {
        const sectionCards = section.querySelectorAll('.product-card-catalog');
        let sectionVisible = false;

        sectionCards.forEach(card => {
          const el = card as HTMLElement;
          const text = `${el.dataset.name} ${el.dataset.materials} ${el.dataset.desc} ${el.dataset.uuid}`;
          const match = text.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) { sectionVisible = true; anyVisible = true; }
        });

        (section as HTMLElement).style.display = sectionVisible ? '' : 'none';
      });

      noResults.classList.toggle('hidden', !anyVisible);
    });

    // 2. Lógica del Modal de Detalles
    function openModal(uuid: string) {
      const p = prodData.find((item: any) => item.id_producto?.toLowerCase() === uuid);
      if (!p) return;

      document.getElementById('modal-title')!.textContent = p.nombre_articulo || 'Sin nombre';
      document.getElementById('modal-uuid')!.textContent = p.id_producto;
      document.getElementById('modal-precio')!.textContent = `$${(p.precio_mayorista || 0).toFixed(2)}`;
      document.getElementById('modal-cat')!.textContent = p.categoria || 'Sin categoría';
      
      document.getElementById('modal-mat')!.textContent = p.materiales || 'No especificado';
      document.getElementById('modal-desc')!.textContent = p.descripcion || 'Sin descripción detallada.';
      
      const icon = iconsData[p.categoria] || 'inventory_2';
      document.getElementById('modal-icon')!.textContent = icon;

      const imgEl = document.getElementById('modal-img') as HTMLImageElement;
      const noImgEl = document.getElementById('modal-no-img')!;
      
      if (p.imagen_url) {
        imgEl.src = p.imagen_url;
        imgEl.classList.remove('hidden');
        noImgEl.classList.add('hidden');
      } else {
        imgEl.src = '';
        imgEl.classList.add('hidden');
        noImgEl.classList.remove('hidden');
        noImgEl.textContent = icon;
      }

      modal.showModal();
    }

    // Escuchamos el clic
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        const uuid = el.dataset.uuid;
        
        if (uuid) openModal(uuid);
      });
    });

    // Cerrar el modal
    const closeBtns = [document.getElementById('btn-close-modal'), document.getElementById('btn-close-modal-footer')];
    closeBtns.forEach(btn => {
      btn?.addEventListener('click', () => modal.close());
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  </script>
</DashboardLayout>