---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:5145";

const operadorId = Astro.cookies.get("id_operador")?.value;
if (!operadorId || operadorId === "undefined" || operadorId === "null") {
    return Astro.redirect("/");
}

async function safeFetch(url: string) {
    try {
        const res = await fetch(url);
        const text = await res.text();
        if (!res.ok || !text || text.trim() === "")
            return { success: false, data: null };
        return JSON.parse(text);
    } catch (e) {
        return { success: false, data: null };
    }
}

const pedidosData = await safeFetch(
    `${API_URL}/api/solicitudes-cotizacion?id_operador=${operadorId}&pageSize=200`,
);
const allPedidos: any[] = pedidosData.data ?? [];

const productosData = await safeFetch(
    `${API_URL}/api/catalogo-productos?pageSize=1000&fields=id_producto,nombre_articulo`,
);
const productosMap = new Map(
    (productosData.data || []).map((prod: any) => [
        prod.id_producto,
        prod.nombre_articulo,
    ]),
);

const mayoristasData = await safeFetch(
    `${API_URL}/api/mayoristas?pageSize=500&fields=id_mayorista,nombre_empresa`,
);
const mayoristasMap = new Map(
    (mayoristasData.data || []).map((m: any) => [
        m.id_mayorista,
        m.nombre_empresa,
    ]),
);

const solicitudesMayoristasData = await safeFetch(
    `${API_URL}/api/solicitudes-mayorista?pageSize=500`,
);
const solicitudesMayoristas: any[] = solicitudesMayoristasData.data ?? [];

function getPedidoMayoristas(pedidoId: string) {
    return solicitudesMayoristas.filter(
        (m: any) => m.id_solicitud?.toLowerCase() === pedidoId?.toLowerCase(),
    );
}

function getProductoNombre(productos: any) {
    if (!productos || !Array.isArray(productos) || productos.length === 0)
        return "—";
    const items = productos.map((prod: any) => {
        const prodId = prod.id ?? prod.id_producto ?? prod.codigo ?? prod;
        const cantidad = prod.cantidad ?? prod.cant ?? 1;
        const nombre = productosMap.get(prodId);
        return nombre ? `${nombre} x${cantidad}` : `ID: ${prodId} x${cantidad}`;
    });
    return items.length > 1 ? `${items[0]} (+${items.length - 1})` : items[0];
}

const total = allPedidos.length;
const pendientesPago = allPedidos.filter(
    (p: any) => p.estado_solicitud?.toLowerCase() === "pendiente",
).length;
const pagados = allPedidos.filter(
    (p: any) => p.estado_solicitud?.toLowerCase() === "completada",
).length;
const enProceso = allPedidos.filter(
    (p: any) => p.estado_solicitud?.toLowerCase() === "en_proceso",
).length;
const aceptadas = allPedidos.filter(
    (p: any) => p.estado_solicitud?.toLowerCase() === "aceptada",
).length;
const rechazadas = allPedidos.filter(
    (p: any) => p.estado_solicitud?.toLowerCase() === "rechazada",
).length;
const reasignar = allPedidos.filter(
    (p: any) => p.estado_solicitud?.toLowerCase() === "requiere_reasignacion",
).length;

const stats: any[] = [
    {
        label: "Pendientes",
        value: pendientesPago,
        icon: "pending",
        iconColor: "text-error",
        bg: "bg-error/5",
        filter: "pendiente",
    },
    {
        label: "En Proceso",
        value: enProceso,
        icon: "autorenew",
        iconColor: "text-secondary",
        bg: "bg-secondary/5",
        filter: "en_proceso",
    },
    {
        label: "Aceptadas",
        value: aceptadas,
        icon: "verified",
        iconColor: "text-tertiary",
        bg: "bg-tertiary/5",
        filter: "aceptada",
    },
    {
        label: "Rechazadas",
        value: rechazadas,
        icon: "cancel",
        iconColor: "text-error",
        bg: "bg-error/5",
        filter: "rechazada",
    },
    {
        label: "Reasignar",
        value: reasignar,
        icon: "swap_horiz",
        iconColor: "text-orange-600",
        bg: "bg-orange-100",
        filter: "requiere_reasignacion",
    },
];

function getStatusStyle(status: string) {
    switch (status?.toLowerCase()) {
        case "pendiente":
            return { class: "bg-amber-100 text-amber-700", icon: "schedule" };
        case "en_proceso":
            return { class: "bg-blue-100 text-blue-700", icon: "autorenew" };
        case "aceptada":
            return { class: "bg-emerald-100 text-emerald-700", icon: "verified" };
        case "completada":
        case "completado":
            return { class: "bg-emerald-100 text-emerald-700", icon: "check_circle" };
        case "rechazada":
            return { class: "bg-red-100 text-red-700", icon: "cancel" };
        case "requiere_reasignacion":
            return { class: "bg-orange-100 text-orange-700", icon: "swap_horiz" };
        default:
            return { class: "bg-surface-container-highest text-on-surface-variant", icon: "help" };
    }
}

function formatDate(dateStr: string) {
    if (!dateStr) return "—";
    return new Date(dateStr).toLocaleDateString("es-MX", {
        day: "2-digit",
        month: "short",
        year: "numeric",
    });
}
---

<DashboardLayout title="Mis Pedidos">
    <div
        id="productos-map"
        class="hidden"
        data-productos={JSON.stringify(Array.from(productosMap.entries()))}
    ></div>
    <div
        id="mayoristas-map"
        class="hidden"
        data-mayoristas={JSON.stringify(Array.from(mayoristasMap.entries()))}
    ></div>
    <div
        id="mayoristas-data"
        class="hidden"
        data-mayoristas={JSON.stringify(solicitudesMayoristas)}
        data-operador-id={operadorId}
    ></div>

    <div class="p-8 space-y-8">
        <div>
            <nav class="flex items-center gap-2 text-sm text-outline mb-4">
                <a href="/dashboard" class="hover:text-primary transition-colors">Dashboard</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-primary font-medium">Mis Pedidos</span>
            </nav>
            <h1 class="font-headline text-4xl font-extrabold text-on-surface tracking-tight">Mis Pedidos</h1>
            <p class="text-on-surface-variant mt-1">Seguimiento de pedidos y estado.</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <button class="filter-btn bg-surface-container-lowest rounded-xl p-5 flex flex-col gap-3 hover:bg-surface-container-low transition-all" data-filter="all">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-primary/5">
                    <span class="material-symbols-outlined text-primary">list</span>
                </div>
                <div>
                    <p class="text-outline text-xs font-bold uppercase tracking-widest">Todos</p>
                    <p class="font-headline text-3xl font-extrabold text-on-surface mt-0.5">{total}</p>
                </div>
            </button>
            {stats.map((s) => (
                <button class="filter-btn bg-surface-container-lowest rounded-xl p-5 flex flex-col gap-3 hover:bg-surface-container-low transition-all" data-filter={s.filter}>
                    <div class={`w-10 h-10 rounded-lg flex items-center justify-center ${s.bg}`}>
                        <span class={`material-symbols-outlined ${s.iconColor}`}>{s.icon}</span>
                    </div>
                    <div>
                        <p class="text-outline text-xs font-bold uppercase tracking-widest">{s.label}</p>
                        <p class="font-headline text-3xl font-extrabold text-on-surface mt-0.5">{s.value}</p>
                    </div>
                </button>
            ))}
        </div>

        <div class="bg-surface-container-lowest rounded-xl overflow-hidden">
            <div class="px-6 py-5 border-b border-outline-variant/10">
                <h2 class="font-headline text-lg font-bold text-on-surface">Historial de Pedidos</h2>
            </div>
            {allPedidos.length === 0 ? (
                <div class="px-6 py-16 text-center text-outline">
                    <span class="material-symbols-outlined text-6xl block mb-4 opacity-20">inventory_2</span>
                    <p class="text-lg font-semibold">No hay pedidos aún</p>
                    <p class="text-sm mt-1">Cuando realices solicitudes, aparecerán aquí.</p>
                </div>
            ) : (
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-surface-container-low text-outline text-xs font-bold uppercase tracking-widest">
                                <th class="px-6 py-4">Pedido</th>
                                <th class="px-6 py-4">Contenido</th>
                                <th class="px-6 py-4 text-center">Estado</th>
                                <th class="px-6 py-4 text-right">Fecha</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/10">
                            {allPedidos.map((p: any) => {
                                const statusStyle = getStatusStyle(p.estado_solicitud);
                                return (
                                    <tr class="pedido-row hover:bg-surface-container-low/50 transition-colors cursor-pointer"
                                        data-pedido={JSON.stringify(p)}
                                        data-filter={(p.estado_solicitud || "").toLowerCase()}>
                                        <td class="px-6 py-5">
                                            <p class="font-bold text-primary text-sm">{p.id_solicitud_cotizacion?.slice(0, 8) || "—"}</p>
                                        </td>
                                        <td class="px-6 py-5 max-w-xs">
                                            <p class="text-sm text-on-surface line-clamp-2">{getProductoNombre(p.productos)}</p>
                                        </td>
                                        <td class="px-6 py-5 text-center">
                                            <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold ${statusStyle.class}`}>
                                                <span class="material-symbols-outlined text-xs">{statusStyle.icon}</span>
                                                {p.estado_solicitud || "—"}
                                            </span>
                                        </td>
                                        <td class="px-6 py-5 text-right">
                                            <p class="text-sm text-outline">{formatDate(p.created_at)}</p>
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            )}
        </div>
    </div>

    <dialog id="modal-detalle" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-group">
                    <div class="modal-icon">
                        <span class="material-symbols-outlined text-2xl">receipt_long</span>
                    </div>
                    <div>
                        <h3 class="font-headline text-lg font-bold">Detalle del Pedido</h3>
                    </div>
                </div>
                <button id="btn-cerrar-modal" class="modal-close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                            <p class="text-xs text-outline uppercase tracking-widest mb-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">info</span>Estado del Pedido
                            </p>
                            <span id="modal-estado" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold">---</span>
                        </div>

                        <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                            <p class="text-xs text-outline uppercase tracking-widest mb-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">tag</span>Identificadores
                            </p>
                            <div class="space-y-2">
                                <div class="bg-surface-container-lowest p-2 rounded">
                                    <p class="text-xs text-outline">ID Solicitud</p>
                                    <p id="modal-id-solicitud" class="text-xs font-mono text-on-surface break-all">---</p>
                                </div>
                                <div class="bg-surface-container-lowest p-2 rounded">
                                    <p class="text-xs text-outline">ID Pedido</p>
                                    <p id="modal-id-pedido" class="text-xs font-mono text-on-surface break-all">---</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                            <p class="text-xs text-outline uppercase tracking-widest mb-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">inventory_2</span>
                                Productos (<span id="modal-count-prods">0</span>)
                            </p>
                            <div id="modal-productos" class="space-y-2"></div>
                        </div>

                        <div id="seccion-aceptada" class="hidden space-y-3">
                            <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                                <p class="text-xs text-outline uppercase tracking-widest mb-3 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">receipt_long</span>Resumen de Precios
                                </p>
                                <div class="space-y-2">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-on-surface">Total Productos</span>
                                        <span id="modal-total-productos" class="text-sm font-bold text-on-surface">$0.00</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-on-surface">Costo Envío</span>
                                        <span id="modal-costo-envio" class="text-sm font-bold text-on-surface">$0.00</span>
                                    </div>
                                    <div class="border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                                        <span class="text-sm font-semibold text-on-surface">Subtotal</span>
                                        <span id="modal-subtotal" class="text-sm font-bold text-primary">$0.00</span>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                                <p class="text-xs text-outline uppercase tracking-widest mb-2 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">payments</span>Ganancia
                                </p>
                                <input type="number" id="modal-ganancia"
                                    class="w-full px-3 py-2 rounded-lg border border-outline-variant/30 bg-surface-container-lowest text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                                    placeholder="0.00" min="0" step="0.01" value="0" />
                            </div>

                            <div class="bg-primary/10 p-4 rounded-xl border border-primary/20">
                                <div class="flex justify-between items-center">
                                    <span class="text-sm font-semibold text-primary">Total Cotización</span>
                                    <span id="modal-total-final" class="text-lg font-bold text-primary">$0.00</span>
                                </div>
                            </div>

                            <button id="btn-generar-cotizacion"
                                class="w-full bg-primary text-white px-4 py-3 rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-primary/90 transition-colors">
                                <span class="material-symbols-outlined">description</span>
                                Generar Cotización Downlabs
                            </button>

                            <a id="btn-descargar-pdf" target="_blank"
                                class="hidden w-full bg-secondary text-white px-4 py-3 rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-secondary/90 transition-colors">
                                <span class="material-symbols-outlined">download</span>
                                Descargar PDF
                            </a>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                                <p class="text-xs text-outline uppercase tracking-widest mb-1 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">calendar_today</span>Creado
                                </p>
                                <p id="modal-fecha" class="text-sm font-semibold text-on-surface">---</p>
                            </div>
                            <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                                <p class="text-xs text-outline uppercase tracking-widest mb-1 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">update</span>Actualizado
                                </p>
                                <p id="modal-fecha-update" class="text-sm font-semibold text-on-surface">---</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/10">
                            <p class="text-xs text-outline uppercase tracking-widest mb-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">store</span>
                                Solicitudes a Mayoristas (<span id="modal-count-mayoristas">0</span>)
                            </p>
                            <div id="modal-mayoristas" class="space-y-3"></div>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                .modal { background: transparent; border: none; padding: 0; max-width: 1100px; width: 95vw; max-height: 95vh; overflow: hidden; margin: auto; }
                .modal::backdrop { background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px); }
                .modal[open] { animation: modalFadeIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); }
                @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.9) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
                .modal-content { background: var(--color-surface-container-lowest, #fefefe); border-radius: 1.5rem; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); }
                .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; background: var(--color-primary, #6750a1); color: white; }
                .modal-title-group { display: flex; align-items: center; gap: 0.75rem; }
                .modal-icon { width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; }
                .modal-close { width: 2.5rem; height: 2.5rem; border-radius: 50%; border: none; background: rgba(255, 255, 255, 0.15); display: flex; align-items: center; justify-content: center; color: white; cursor: pointer; transition: all 0.2s; }
                .modal-close:hover { background: rgba(255, 255, 255, 0.25); }
                .modal-body { padding: 1.5rem; overflow-y: auto; max-height: calc(95vh - 6rem); }
                .producto-card { background: var(--color-surface-container-low, #f5f5f5); border-radius: 0.75rem; padding: 0.875rem; border-left: 4px solid var(--color-primary, #6750a1); }
                .filter-btn { border: none; cursor: pointer; text-align: left; width: 100%; }
                .filter-btn:hover { transform: translateY(-2px); }
                .filter-btn.active { ring: 2px; ring-color: var(--color-primary, #6750a1); background: var(--color-surface-container-low, #e7e0ec); }
                .pedido-row { transition: all 0.2s; }
                .pedido-row.hidden { display: none; }
            </style>

            <script>
                const API_URL = (window as any).__API_URL__ || 'http://localhost:5145';

                const productosEl = document.getElementById("productos-map");
                const productosData = JSON.parse(productosEl?.dataset?.productos || "[]");
                const productosMap = new Map(productosData);

                const mayoristasMapEl = document.getElementById("mayoristas-map");
                const mayoristasMapData = JSON.parse(mayoristasMapEl?.dataset?.mayoristas || "[]");
                const mayoristasMap = new Map(mayoristasMapData);

                const mayoristasEl = document.getElementById("mayoristas-data");
                const solicitudesMayoristas = JSON.parse(mayoristasEl?.dataset?.mayoristas || "[]");

                const modal = document.getElementById("modal-detalle") as HTMLDialogElement;
                const btnCerrar = document.getElementById("btn-cerrar-modal");

                let cotizacionData: any = {
                    productos: [],
                    mayoristas: [],
                    idSolicitud: "",
                    idPedido: ""
                };

                document.querySelectorAll("[data-pedido]").forEach((row) => {
                    row.addEventListener("click", () => {
                        const data = JSON.parse(row.getAttribute("data-pedido") || "{}");
                        const idSolicitud = data.id_solicitud_cotizacion || "—";
                        const idPedidoRaw = data.id_pedido ? String(data.id_pedido) : "Sin pedido vinculado";

                        const modalIdSolicitud = document.getElementById("modal-id-solicitud");
                        const modalIdPedido = document.getElementById("modal-id-pedido");
                        if (modalIdSolicitud) modalIdSolicitud.textContent = idSolicitud;
                        if (modalIdPedido) modalIdPedido.textContent = idPedidoRaw;

                        const estado = (data.estado_solicitud || "").toLowerCase();
                        const estadoStyles: Record<string, string> = {
                            pendiente: "bg-amber-100 text-amber-700",
                            procesando: "bg-blue-100 text-blue-700",
                            aceptada: "bg-emerald-100 text-emerald-700",
                            completada: "bg-emerald-100 text-emerald-700",
                            completado: "bg-emerald-100 text-emerald-700",
                            rechazada: "bg-red-100 text-red-700",
                            requiere_reasignacion: "bg-orange-100 text-orange-700",
                        };
                        const estadoEl = document.getElementById("modal-estado") as HTMLElement;
                        if (estadoEl) {
                            estadoEl.className = `inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-bold ${estadoStyles[estado] || "bg-gray-100 text-gray-700"}`;
                            estadoEl.textContent = data.estado_solicitud || "—";
                        }

                        const seccionAceptada = document.getElementById("seccion-aceptada") as HTMLElement;
                        if (seccionAceptada) seccionAceptada.classList.toggle("hidden", estado !== "aceptada");

                        const productosList = document.getElementById("modal-productos") as HTMLElement;
                        productosList.innerHTML = "";
                        const productos = Array.isArray(data.productos) ? data.productos : [];
                        document.getElementById("modal-count-prods")!.textContent = String(productos.length);

                        const prodsForCotizacion: any[] = [];
                        if (productos.length === 0) {
                            productosList.innerHTML = '<p class="text-sm text-outline">Sin productos</p>';
                        } else {
                            productos.forEach((prod: any) => {
                                const prodId = prod.id ?? prod.id_producto ?? prod.codigo ?? "—";
                                const nombre = productosMap.get(String(prodId)) || (prod.nombre_articulo ?? prod.nombre ?? `ID: ${prodId}`);
                                const cantidad = prod.cantidad ?? prod.cant ?? 1;
                                prodsForCotizacion.push({ id: prodId, nombre, cantidad, precio: 0 });
                                const div = document.createElement("div");
                                div.className = "producto-card flex justify-between items-center";
                                div.innerHTML = `
                                    <div class="flex-1 min-w-0 pr-2">
                                        <p class="text-sm font-semibold text-on-surface truncate">${nombre}</p>
                                        <p class="text-xs text-outline font-mono">ID: ${String(prodId)}</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold text-primary">x${cantidad}</p>
                                        <p class="text-xs font-bold precio-prod text-secondary">$0.00</p>
                                    </div>`;
                                productosList.appendChild(div);
                            });
                        }

                        const modalMayoristas = document.getElementById("modal-mayoristas") as HTMLElement;
                        modalMayoristas.innerHTML = "";
                        const pedidoId = data.id_solicitud_cotizacion;
                        const mayoristasDelPedido = solicitudesMayoristas.filter(
                            (m: any) => m.id_solicitud?.toLowerCase() === pedidoId?.toLowerCase()
                        );
                        document.getElementById("modal-count-mayoristas")!.textContent = String(mayoristasDelPedido.length);

                        const maysForCotizacion: any[] = [];
                        if (mayoristasDelPedido.length === 0) {
                            modalMayoristas.innerHTML = '<p class="text-sm text-outline">Sin solicitudes a mayoristas</p>';
                        } else {
                            mayoristasDelPedido.forEach((m: any) => {
                                const nombreMayorista = mayoristasMap.get(String(m.id_mayorista)) || `Mayorista ${String(m.id_mayorista || "").slice(0, 8)}`;
                                const estadoColor = m.estado?.toLowerCase() === "aceptada" ? "text-emerald-600"
                                    : m.estado?.toLowerCase() === "rechazada" ? "text-red-600"
                                    : m.estado?.toLowerCase() === "pendiente" ? "text-amber-600" : "text-on-surface";

                                const prodsSolicitados = Array.isArray(m.productos) ? m.productos : [];
                                const maysProds: any[] = [];
                                const prodsHtml = prodsSolicitados.length > 0
                                    ? prodsSolicitados.map((p: any) => {
                                        const prodId = p.id ?? p.id_producto ?? p.codigo ?? "";
                                        const nombre = productosMap.get(String(prodId)) || prodId;
                                        const cantidad = p.cantidad ?? p.cant ?? 1;
                                        maysProds.push({ id: prodId, nombre, cantidad, precio: 0 });
                                        return `<span class="mayorista-prod-span inline-block bg-surface-container-highest px-2 py-1 rounded text-xs mr-1 mb-1" data-prod-id="${prodId}" data-cantidad="${cantidad}">${nombre} x${cantidad}</span>`;
                                    }).join("")
                                    : '<span class="text-xs text-outline">Sin productos</span>';

                                maysForCotizacion.push({
                                    nombre: nombreMayorista,
                                    productos: maysProds,
                                    costoEnvio: Number(m.costo_envio || 0)
                                });

                                const div = document.createElement("div");
                                div.className = "producto-card flex flex-col w-full";
                                div.innerHTML = `
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <p class="text-sm font-bold text-primary">${nombreMayorista}</p>
                                            <p class="text-xs text-outline">Estado: <span class="font-bold ${estadoColor}">${m.estado || "—"}</span></p>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <p class="text-xs text-outline mb-1">Productos solicitados:</p>
                                        <div class="flex flex-wrap">${prodsHtml}</div>
                                    </div>
                                    <div class="mt-1 pt-1 border-t border-outline-variant/20 grid grid-cols-2 gap-2">
                                        <div>
                                            <p class="text-xs text-outline">Tiempo entrega</p>
                                            <p class="text-xs font-medium text-on-surface">${m.tiempo_entrega_dias ? `${m.tiempo_entrega_dias} días` : "—"}</p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-outline">Costo envío</p>
                                            <p class="mayorista-costo-envio text-xs font-medium text-on-surface">${m.costo_envio ? `$${Number(m.costo_envio).toFixed(2)}` : "$0.00"}</p>
                                        </div>
                                    </div>
                                    ${m.notas_adicionales ? `<div class="mt-1 pt-1 border-t border-outline-variant/20"><p class="text-xs text-outline">Notas</p><p class="text-xs text-on-surface line-clamp-2">${m.notas_adicionales}</p></div>` : ""}`;
                                div.classList.add("mayorista-card");
                                modalMayoristas.appendChild(div);
                            });
                        }

                        cotizacionData = {
                            productos: prodsForCotizacion,
                            mayoristas: maysForCotizacion,
                            idSolicitud,
                            idPedido: idPedidoRaw
                        };

                        const formatDate = (d: string) => d ? new Date(d).toLocaleDateString("es-MX", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "—";
                        document.getElementById("modal-fecha")!.textContent = formatDate(data.created_at);
                        document.getElementById("modal-fecha-update")!.textContent = formatDate(data.updated_at);

                        (document.getElementById("modal-ganancia") as HTMLInputElement).value = "0";
                        document.getElementById("modal-total-productos")!.textContent = "$0.00";
                        document.getElementById("modal-costo-envio")!.textContent = "$0.00";
                        document.getElementById("modal-subtotal")!.textContent = "$0.00";
                        document.getElementById("modal-total-final")!.textContent = "$0.00";
                        const btnGen = document.getElementById("btn-generar-cotizacion");
                        const btnDes = document.getElementById("btn-descargar-pdf");
                        if (btnGen) btnGen.classList.remove("hidden");
                        if (btnDes) {
                            btnDes.classList.add("hidden");
                            btnDes.removeAttribute("href");
                            btnDes.removeAttribute("download");
                        }
                        const mayDataEl = document.getElementById("mayoristas-data");
                        (window as any).__operadorId__ = mayDataEl?.dataset?.operadorId || "";

                        modal.showModal();

                        if (estado === "aceptada") {
                            fetchMayoristaPrecios(idSolicitud);
                        }
                    });
                });

async function fetchMayoristaPrecios(idSolicitud: string) {
    const allIds: string[] = [];
    cotizacionData.productos.forEach((p: any) => {
        if (!allIds.includes(p.id)) allIds.push(p.id);
    });
    cotizacionData.mayoristas.forEach((may: any) => {
        may.productos.forEach((p: any) => {
            if (!allIds.includes(p.id)) allIds.push(p.id);
        });
    });

    if (allIds.length === 0) return;

    try {
        const res = await fetch(`/api/productos-precio?ids=${allIds.join(",")}`);
        const data = await res.json();
        const priceMap: Record<string, number> = {};
        if (data.success && data.data) {
            Object.assign(priceMap, data.data);
        }

        let totalProductos = 0;
        let totalCostoEnvio = 0;
        const countedIds = new Set<string>();

        cotizacionData.productos.forEach((p: any) => {
            const precio = priceMap[p.id] || 0;
            p.precio = precio;
            if (!countedIds.has(p.id)) {
                totalProductos += precio * p.cantidad;
                countedIds.add(p.id);
            }
            document.querySelectorAll(".producto-card").forEach((card: any) => {
                const textId = card.querySelector(".font-mono")?.textContent || "";
                if (textId.includes(p.id)) {
                    const precioEl = card.querySelector(".precio-prod");
                    if (precioEl) precioEl.textContent = `$${precio.toFixed(2)}`;
                }
            });
        });

        cotizacionData.mayoristas.forEach((may: any) => {
            totalCostoEnvio += may.costoEnvio;
            may.productos.forEach((p: any) => {
                const precio = priceMap[p.id] || 0;
                p.precio = precio;
                if (!countedIds.has(p.id)) {
                    totalProductos += precio * p.cantidad;
                    countedIds.add(p.id);
                }
            });
        });

        const spanTP = document.getElementById("modal-total-productos");
        const spanCE = document.getElementById("modal-costo-envio");
        if (spanTP) spanTP.textContent = `$${totalProductos.toFixed(2)}`;
        if (spanCE) spanCE.textContent = `$${totalCostoEnvio.toFixed(2)}`;

        const inputGanancia = document.getElementById("modal-ganancia") as HTMLInputElement;
        const ganancia = Number(inputGanancia?.value || 0);
        const subtotal = totalProductos + totalCostoEnvio;
        const totalFinal = subtotal + ganancia;
        const spanSub = document.getElementById("modal-subtotal");
        const spanTot = document.getElementById("modal-total-final");
        if (spanSub) spanSub.textContent = `$${subtotal.toFixed(2)}`;
        if (spanTot) spanTot.textContent = `$${totalFinal.toFixed(2)}`;
    } catch (e) {
        console.error("Error fetching prices:", e);
    }
}

function blobToBase64(blob: Blob): Promise<string> {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => resolve((reader.result as string).split(',')[1]);
        reader.onerror = reject;
        reader.readAsDataURL(blob);
    });
}

function recalcularTotales() {
    const tp = parseFloat(document.getElementById("modal-total-productos")?.textContent?.replace("$", "") || "0");
    const ce = parseFloat(document.getElementById("modal-costo-envio")?.textContent?.replace("$", "") || "0");
    const gan = Number((document.getElementById("modal-ganancia") as HTMLInputElement)?.value || "0");
    const sub = tp + ce;
    const tot = sub + gan;
    const spanSub = document.getElementById("modal-subtotal");
    const spanTot = document.getElementById("modal-total-final");
    if (spanSub) spanSub.textContent = `$${sub.toFixed(2)}`;
    if (spanTot) spanTot.textContent = `$${tot.toFixed(2)}`;
}

const inputGanancia = document.getElementById("modal-ganancia") as HTMLInputElement;
inputGanancia?.addEventListener("input", recalcularTotales);

const btnGenerar = document.getElementById("btn-generar-cotizacion") as HTMLButtonElement;
    btnGenerar?.addEventListener("click", async () => {
    if (!btnGenerar) return;
    btnGenerar.textContent = 'Guardando...';
    const gan = Number(inputGanancia?.value || "0");

    let idCotizacion: string | null = null;
    if (cotizacionData.idSolicitud && cotizacionData.idSolicitud !== "—") {
        try {
            const resCot = await fetch(`/api/buscar-cotizacion?id_solicitud=${cotizacionData.idSolicitud}`);
            const dataCot = await resCot.json();
            if (dataCot.success && dataCot.id_cotizacion) {
                idCotizacion = dataCot.id_cotizacion;
                await fetch('/api/guardar-ganancia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        idCotizacion: dataCot.id_cotizacion,
                        ganancia: gan,
                    }),
                });
            }
        } catch (e) {
            console.warn("No se pudo guardar la cotizacion:", e);
        }
    }

    btnGenerar.textContent = 'Generando PDF...';
    btnGenerar.setAttribute('disabled', 'true');
    try {
        if (!(window as any).jspdf) {
            await new Promise<void>((resolve, reject) => {
                const script = document.createElement('script');
                script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
                script.onload = () => resolve();
                script.onerror = () => reject(new Error('Failed to load jsPDF'));
                document.head.appendChild(script);
            });
        }

        const { jsPDF } = (window as any).jspdf;
        const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
        const W = 210, margin = 20, colorPrimario: [number, number, number] = [1, 105, 111], grisOscuro: [number, number, number] = [60, 60, 60];
        let y = margin;

        doc.setFillColor(...colorPrimario);
        doc.rect(0, 0, W, 30, 'F');
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(22);
        doc.setTextColor(255, 255, 255);
        doc.text('DownLabs', margin, 20);
        doc.setFontSize(10);
        doc.setFont('helvetica', 'normal');
        doc.text('COTIZACIÓN B2B', W - margin, 15, { align: 'right' });
        doc.text('Solicitud: ' + (cotizacionData.idSolicitud || '—'), W - margin, 25, { align: 'right' });

        y = 45;
        doc.setFontSize(14);
        doc.setTextColor(...colorPrimario);
        doc.setFont('helvetica', 'bold');
        doc.text('Detalle de Productos', margin, y);
        y += 10;

        doc.setFillColor(240, 240, 240);
        doc.rect(margin, y - 5, W - margin * 2, 8, 'F');
        doc.setFontSize(10);
        doc.setTextColor(...grisOscuro);
        doc.text('Producto', margin + 2, y);
        doc.text('Cant.', W - margin - 60, y);
        doc.text('Precio U.', W - margin - 40, y);
        doc.text('Subtotal', W - margin - 5, y, { align: 'right' });
        y += 10;

        let total = 0;
        const countedIds = new Set<string>();
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(10);

        cotizacionData.productos.forEach((p: any) => {
            if (y > 250) { doc.addPage(); y = margin; }
            const nombre = p.nombre || 'Producto';
            const cantidad = p.cantidad || 1;
            const precio = p.precio || 0;
            const subtotal = precio * cantidad;
            if (!countedIds.has(p.id)) {
                total += subtotal;
                countedIds.add(p.id);
            }
            doc.setTextColor(...grisOscuro);
            doc.text((nombre as string).substring(0, 35), margin + 2, y);
            doc.text(String(cantidad), W - margin - 60, y);
            doc.text('$' + precio.toFixed(2), W - margin - 40, y);
            doc.text('$' + subtotal.toFixed(2), W - margin - 5, y, { align: 'right' });
            y += 8;
        });

        cotizacionData.mayoristas.forEach((may: any) => {
            may.productos.forEach((p: any) => {
                if (y > 250) { doc.addPage(); y = margin; }
                const nombre = p.nombre || 'Producto';
                const cantidad = p.cantidad || 1;
                const precio = p.precio || 0;
                const subtotal = precio * cantidad;
                if (!countedIds.has(p.id)) {
                    total += subtotal;
                    countedIds.add(p.id);
                }
                doc.setTextColor(120, 120, 120);
                doc.text('  ' + (nombre as string).substring(0, 33), margin + 2, y);
                doc.text(String(cantidad), W - margin - 60, y);
                doc.text('$' + precio.toFixed(2), W - margin - 40, y);
                doc.text('$' + subtotal.toFixed(2), W - margin - 5, y, { align: 'right' });
                y += 7;
            });
            if (may.costoEnvio > 0) {
                if (y > 250) { doc.addPage(); y = margin; }
                doc.setTextColor(...grisOscuro);
                doc.text('  Envío (' + may.nombre + ')', margin + 2, y);
                doc.text('1', W - margin - 60, y);
                doc.text('$' + may.costoEnvio.toFixed(2), W - margin - 40, y);
                doc.text('$' + may.costoEnvio.toFixed(2), W - margin - 5, y, { align: 'right' });
                y += 7;
                total += may.costoEnvio;
            }
        });

        y += 8;
        doc.setDrawColor(...colorPrimario);
        doc.line(margin, y, W - margin, y);
        y += 10;

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.setTextColor(...grisOscuro);
        doc.text('Subtotal:', W - margin - 50, y);
        doc.text('$' + total.toFixed(2), W - margin - 5, y, { align: 'right' });
        y += 8;

        const ganancia = Number(inputGanancia?.value || 0);
        if (ganancia > 0) {
            doc.text('Ganancia:', W - margin - 50, y);
            doc.text('$' + ganancia.toFixed(2), W - margin - 5, y, { align: 'right' });
            y += 8;
        }

        const totalFinal = total + ganancia;
        doc.setFontSize(14);
        doc.setTextColor(...colorPrimario);
        doc.text('TOTAL:', W - margin - 50, y);
        doc.text('$' + totalFinal.toFixed(2), W - margin - 5, y, { align: 'right' });

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.setTextColor(150, 150, 150);
        doc.text('Generado el ' + new Date().toLocaleDateString('es-MX'), W / 2, 280, { align: 'center' });

        const pdfBlob = doc.output('blob');
        const base64 = await blobToBase64(pdfBlob);
        const fileName = `cotizacion-${idCotizacion}-${Date.now()}.pdf`;

        btnGenerar.textContent = 'Subiendo PDF...';

        try {
            const resSubir = await fetch('/api/subir-pdf', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pdfBase64: base64,
                    fileName: fileName,
                    idCotizacion: idCotizacion,
                }),
            });
            const dataSubir = await resSubir.json();

            if (dataSubir.success && dataSubir.url) {
                btnGenerar.classList.add('hidden');
                const btnDescargar = document.getElementById('btn-descargar-pdf') as HTMLAnchorElement;
                if (btnDescargar) {
                    btnDescargar.href = dataSubir.url;
                    btnDescargar.download = fileName;
                    btnDescargar.classList.remove('hidden');
                }
            } else {
                doc.save(fileName);
                alert('PDF generado pero no se pudo subir: ' + (dataSubir.error || 'Error desconocido'));
            }
        } catch (e) {
            doc.save(fileName);
            alert('Error al subir PDF, se descargará localmente');
        }

        btnGenerar.textContent = 'PDF Descargado';
    } catch (error: any) {
        console.error('Error PDF:', error);
        alert('Error al generar PDF: ' + error.message);
    } finally {
        btnGenerar.innerHTML = '<span class="material-symbols-outlined">description</span> Generar Cotización Downlabs';
        btnGenerar.removeAttribute('disabled');
    }
});

                btnCerrar?.addEventListener("click", () => modal.close());
                modal.addEventListener("click", (e) => { if (e.target === modal) modal.close(); });

                const filterBtns = document.querySelectorAll(".filter-btn");
                const tableRows = document.querySelectorAll(".pedido-row");

                filterBtns.forEach((btn: any) => {
                    btn.addEventListener("click", () => {
                        const filter = btn.getAttribute("data-filter");
